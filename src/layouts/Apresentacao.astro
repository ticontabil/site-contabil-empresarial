---
// Layout próprio da apresentação: sem cabeçalho/rodapé do site, noindex, Montserrat.
import "@fontsource-variable/montserrat";
import "@fontsource-variable/montserrat/wght-italic.css";
import "../styles/apresentacao.css";
import { geral } from "../data/apresentacao.ts";

interface Props { titulo?: string; descricao?: string }
const { titulo = geral.titulo, descricao = geral.slogan } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#000000" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="icon" href="/favicon.ico" />
    <script is:inline>
      // modos antes de pintar: rascunho, impressão, embutido
      (function () {
        var q = new URLSearchParams(location.search), h = document.documentElement;
        if (q.get("rascunho") === "1") h.classList.add("rascunho");
        if (q.get("imprimir") === "1") h.classList.add("imprimir", "estatico");
        if (q.get("embed") === "1") h.classList.add("embutido");
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
