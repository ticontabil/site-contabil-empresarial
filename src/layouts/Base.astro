---
import "../styles/global.css";
import { meta, contato, whatsapp } from "../data/site";
import { faq, duvidasRapidas } from "../data/faq";
import { filiais } from "../data/secoes";
import Medicao from "../components/Medicao.astro";

interface Props {
  noindex?: boolean;
  title?: string;
  description?: string;
  /** dados estruturados extras da página (FAQ, lista de notícias etc.) */
  schema?: Record<string, unknown>[];
  /** home: inclui o FAQ nos dados estruturados */
  home?: boolean;
}
const { noindex = false, title = meta.title, description = meta.description, schema = [], home = false } = Astro.props;
const site = Astro.site!;
const ogImage = new URL(meta.ogImage, site).toString();
// endereço canônico sem ".html" e sem barra no fim (o servidor serve /trabalheconosco a partir do .html)
const caminho = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/").replace(/(.)\/$/, "$1");
const canonico = new URL(caminho, site).toString();

// Dados estruturados (schema.org): o escritório e as três unidades. Ajuda o Google a mostrar
// nome, endereço, telefone e mapa nas buscas locais ("contabilidade em Itumbiara" etc.).
const partes = (e: string) => {
  // "R. Rui de Almeida, 180 - St. Central, Itumbiara - GO" / "Av. T-63, 1296, Sala 110, Setor Bueno, Goiânia - GO"
  const uf = e.slice(e.lastIndexOf(" - ") + 3).trim();
  const corpo = e.slice(0, e.lastIndexOf(" - "));
  const cidade = corpo.split(/,\s*|\s-\s/).pop()!.trim();
  const rua = corpo.slice(0, corpo.lastIndexOf(cidade)).replace(/[,\s-]+$/, "").trim();
  return { "@type": "PostalAddress", streetAddress: rua, addressLocality: cidade, addressRegion: uf, addressCountry: "BR" };
};
const telefone = "+55-64-3431-6397";
const org = {
  "@context": "https://schema.org",
  "@type": "AccountingService",
  "@id": `${site}#escritorio`,
  name: meta.siteName,
  legalName: contato.razaoSocial,
  taxID: contato.cnpj,
  url: site.toString(),
  logo: new URL("/logo.png", site).toString(),
  image: ogImage,
  description: meta.description,
  foundingDate: "1984",
  telephone: telefone,
  email: contato.email,
  priceRange: "$$",
  address: { ...partes(contato.enderecos[0]), postalCode: filiais.cidades[0].cep },
  areaServed: ["Itumbiara", "Goiânia", "Uberlândia", "Goiás", "Minas Gerais"].map((n) => ({ "@type": "Place", name: n })),
  sameAs: [meta.instagram],
  contactPoint: [{ "@type": "ContactPoint", telephone: telefone, contactType: "customer service", areaServed: "BR", availableLanguage: "Portuguese", url: whatsapp.numero }],
  hasMap: filiais.cidades[0].waze,
  department: filiais.cidades.filter((f) => f.tipo === "Filial").map((f, i) => ({
    "@type": "AccountingService",
    "@id": `${site}#unidade-${i + 2}`,
    name: `${meta.siteName} · ${f.cidade}`,
    address: { "@type": "PostalAddress", ...(f.endereco ? { streetAddress: f.endereco } : {}), addressLocality: f.cidade, addressRegion: f.uf, addressCountry: "BR" },
    ...(f.lat != null ? { geo: { "@type": "GeoCoordinates", latitude: f.lat, longitude: f.lng } } : {}),
    hasMap: f.waze,
    telephone: telefone,
    url: site.toString(),
  })),
};
const siteSchema = { "@context": "https://schema.org", "@type": "WebSite", name: meta.siteName, url: site.toString(), inLanguage: "pt-BR", publisher: { "@id": `${site}#escritorio` } };
const faqSchema = home && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [...faq, ...duvidasRapidas].map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
const blocos = [org, siteSchema, ...(faqSchema ? [faqSchema] : []), ...schema];
---

<!doctype html>
<html lang={meta.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="canonical" href={canonico} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="theme-color" content="#ff6a00" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.siteName} />
    <meta property="og:locale" content={meta.locale} />
    <meta property="og:url" content={canonico} />
    <meta property="og:title" content={title === meta.title ? meta.ogTitle : title} />
    <meta property="og:description" content={title === meta.title ? meta.ogDescription : description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Página inicial da Contábil Empresarial" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title === meta.title ? meta.ogTitle : title} />
    <meta name="twitter:description" content={title === meta.title ? meta.ogDescription : description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="geo.region" content="BR-GO" />
    <meta name="geo.placename" content="Itumbiara" />

    {blocos.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}

    <!--
      Tema: escolha salva (localStorage "theme") ou, se não houver, a preferência do sistema.
      Aplicado antes de pintar a página para não piscar. Cores, logo e ícone seguem o mesmo estado.
    -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "dark" && t !== "light") t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.classList.toggle("dark", t === "dark");
      })();
    </script>
  </head>
  <body>
    <div id="root">
      <div role="region" aria-label="Notifications (F8)" tabindex="-1" style="pointer-events: none;">
        <ol
          tabindex="-1"
          class="fixed top-0 z-[100] flex max-h-screen w-full flex-col-reverse p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]"
          data-toast-viewport
        ></ol>
      </div>
      <div class="min-h-screen bg-background text-foreground">
        <slot />
      </div>
    </div>
    <Medicao />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
