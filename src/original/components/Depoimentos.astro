---
import Icon from "./Icon.astro";
import { depoimentos } from "../data/secoes";
const primeiro = depoimentos[0];
---

<section class="py-24 bg-secondary/50" data-depoimentos={JSON.stringify(depoimentos)}>
  <div class="container mx-auto px-4 max-w-3xl text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-12">O que nossos <span class="text-primary">clientes</span> dizem</h2>
    <Icon name="Quote" size={48} class="text-primary mx-auto mb-6" />
    <p class="text-lg md:text-xl mb-8 leading-relaxed" data-dep-texto>"{primeiro.texto}"</p>
    <p class="font-semibold" data-dep-nome>{primeiro.nome}</p>
    <p class="text-sm text-muted-foreground" data-dep-cargo>{primeiro.cargo}</p>
    <div class="flex justify-center gap-4 mt-8">
      <button class="p-2 rounded-full border border-border hover:border-primary transition-colors" aria-label="Anterior" data-dep-prev>
        <Icon name="ChevronLeft" size={20} />
      </button>
      <button class="p-2 rounded-full border border-border hover:border-primary transition-colors" aria-label="Próximo" data-dep-next>
        <Icon name="ChevronRight" size={20} />
      </button>
    </div>
  </div>
</section>
