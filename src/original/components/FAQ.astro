---
import Accordion from "./Accordion.astro";
import { faq } from "../data/faq";
---

<section id="faq" class="py-24">
  <div class="container mx-auto px-4 max-w-3xl">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">Perguntas <span class="text-primary">Frequentes</span></h2>
    <Accordion itens={faq} variante="faq" />
  </div>
</section>
