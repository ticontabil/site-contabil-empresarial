---
// Ícone lucide com o mesmo markup do original: <svg class="lucide lucide-nome ...">.
import { icons } from "../data/icons";

interface Props {
  name: string;
  size?: number;
  class?: string;
  [key: string]: any;
}
const { name, size = 24, class: className = "", ...rest } = Astro.props;
const kebab = name.replace(/([a-z0-9])([A-Z])/g, "$1-$2").toLowerCase();
const body = icons[name];
if (!body) throw new Error(`Ícone não encontrado: ${name}`);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`lucide lucide-${kebab} ${className}`.trim()}
  {...rest}
  set:html={body}
/>
