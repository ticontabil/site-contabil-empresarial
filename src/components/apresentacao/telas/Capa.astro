---
import Tela from "../Tela.astro";
import Txt from "../Txt.astro";
import Video from "../Video.astro";
import { telas } from "../../../data/apresentacao.ts";
import type { TelaAtiva } from "../../../lib/apresentacao-telas.ts";
const { info } = Astro.props as { info: TelaAtiva };
const d = telas.capa;
// contraste de pesos: 1ª palavra Black, meio Light, última palavra Light Itálico (acento)
const palavras = d.tela.titulo.split(" ");
const primeira = palavras[0];
const meio = palavras.slice(1, -1).join(" ");
const ultima = palavras[palavras.length - 1];
const giro = "AVANÇAR · CONTÁBIL EMPRESARIAL · DESDE 1984 · ";
---
<Tela info={info}>
  <span class="risco-luz" aria-hidden="true"></span>
  <!-- vídeo da fachada da matriz ocupando a tela inteira (em loop, só toca com a capa na frente) -->
  <div class="capa-video" aria-hidden="true"><Video nome="capa-fachada" pelicula={false} /></div>
  <div class="capa-sombra" aria-hidden="true"></div>
  <div class="degrade-base"></div>
  <p class="topo rotulo entra">({d.tela.sobretitulo})</p>
  <div class="selo-giro entra d3" aria-hidden="true">
    <svg viewBox="0 0 200 200" class="giro">
      <defs><path id="giro-circulo" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs>
      <text><textPath href="#giro-circulo" textLength="488">{giro}</textPath></text>
    </svg>
    <span class="seta">→</span>
  </div>
  <div class="bloco-titulo">
    <h1 class="titulo entra"><strong>{primeira}</strong> <span class="leve">{meio}</span> <em class="acento">{ultima}</em></h1>
    <p class="apoio entra d2"><Txt t={d.tela.apoio} /></p>
  </div>
  <div class="nome-gigante entra d3" data-ajustar-largura><span>{d.tela.nomeGigante}</span></div>
</Tela>
