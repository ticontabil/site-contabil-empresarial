---
// Logo do pré-loader montada peça por peça (28/11/2026). A logo é só um PNG (public/logo-negative.png, 568×229),
// então cada peça é um "recorte" dela: a moldura se desenha como uma planta, as letras de CONTÁBIL sobem,
// o acento cai no Á, EMPRESARIAL gira letra a letra do centro para fora, DESDE 1984 e o slogan fecham.
// Coordenadas medidas em pixels da imagem original. Animações em apresentacao.css (seção PRÉ-LOADER).
const W = 568, H = 229;
type P = { x: number; y: number; w: number; h: number; c: string; d: number };
const peca = (x: number, y: number, w: number, h: number, c: string, d: number): P => ({ x, y, w, h, c, d });
const estilo = (p: P) => {
  const px = p.w >= W ? 0 : (p.x / (W - p.w)) * 100;
  const py = p.h >= H ? 0 : (p.y / (H - p.h)) * 100;
  return `left:${(p.x / W) * 100}%;top:${(p.y / H) * 100}%;width:${(p.w / W) * 100}%;height:${(p.h / H) * 100}%;` +
    `--bs:${(W / p.w) * 100}% ${(H / p.h) * 100}%;--bp:${px}% ${py}%;--d:${p.d.toFixed(3)}s`;
};
const faixa = (xs: [number, number][], y: number, h: number, c: string, d0: number, passo: number, ordem?: number[]) =>
  xs.map(([a, b], i) => peca(a - 1, y, b - a + 3, h, c, d0 + (ordem ? ordem[i] : i) * passo));

// moldura (linhas horizontais nascem do centro; verticais descem/sobem)
const linhas = [
  peca(0, 26, 568, 8, "pl-h", 0.15), peca(0, 139, 568, 8, "pl-h", 0.28),
  peca(19, 10, 8, 208, "pl-v desce", 0.42), peca(541, 10, 8, 208, "pl-v sobe", 0.5),
];
// CONTÁBIL (o Á entra sem o acento; o acento cai depois)
const contabil = faixa([[41, 92], [105, 157], [175, 229], [244, 296], [298, 361], [374, 425], [442, 459], [478, 526]], 44, 87, "pl-letra", 0.62, 0.065)
  .map((p, i) => (i === 4 ? { ...p, y: 62, h: 69 } : p));
const acento = peca(313, 43, 50, 19, "pl-acento", 1.3);
// EMPRESARIAL: do centro para fora
const emp: [number, number][] = [[43, 73], [84, 131], [144, 182], [191, 231], [241, 272], [281, 314], [317, 363], [371, 411], [421, 434], [441, 486], [494, 525]];
const meio = (emp.length - 1) / 2;
const empresarial = faixa(emp, 151, 32, "pl-gira", 1.12, 0.045, emp.map((_, i) => Math.abs(i - meio)));
// DESDE 1984
const desde = faixa([[38, 51], [54, 64], [66, 76], [80, 93], [96, 106], [117, 122], [128, 139], [141, 152], [154, 165]], 0, 18, "pl-desde", 1.4, 0.035);
const slogan = peca(40, 195, 490, 34, "pl-slogan", 1.55);
const pecas = [...linhas, ...contabil, acento, ...empresarial, ...desde, slogan];
// cruzamentos da moldura: brilham quando as linhas se encontram
const cruz = [[22.5, 30], [544.5, 30], [22.5, 143], [544.5, 143]].map(([x, y], i) => ({ x: (x / W) * 100, y: (y / H) * 100, d: 0.78 + i * 0.06 }));
---
<div class="pl-logo" role="img" aria-label="Contábil Empresarial">
  {pecas.map((p) => <span class={`pl-pc ${p.c}`} style={estilo(p)}><i></i></span>)}
  {cruz.map((c) => <b class="pl-cruz" style={`left:${c.x}%;top:${c.y}%;--d:${c.d}s`}></b>)}
  <b class="pl-faisca" style={`left:${(338 / W) * 100}%;top:${(60 / H) * 100}%`}></b>
  <span class="pl-reflexo"></span>
</div>
