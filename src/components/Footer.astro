---
import Icon from "./Icon.astro";
import Accordion from "./Accordion.astro";
import { duvidasRapidas } from "../data/faq";
import { contato, rodape } from "../data/site";
---

<footer class="border-t border-border bg-background">
  <div class="container mx-auto px-4 py-12">
    <h3 class="text-xl font-bold text-center mb-6">Dúvidas <span class="text-primary">Rápidas</span></h3>
    <div class="max-w-2xl mx-auto">
      <Accordion itens={duvidasRapidas} variante="rodape" />
    </div>
  </div>
  <div class="border-t border-border py-12">
    <div class="container mx-auto px-4">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
        <div>
          <img src="/logo.png" alt="Contábil Empresarial" class="h-14 mb-3 dark:hidden" />
          <img src="/logo-negative.png" alt="Contábil Empresarial" loading="lazy" class="h-14 mb-3 hidden dark:inline" />
          <p class="text-sm text-muted-foreground">{rodape.slogan}</p>
        </div>
        <div>
          <h4 class="font-semibold mb-3">Links Rápidos</h4>
          <ul class="space-y-2 text-sm text-muted-foreground">
            <li><a href="/#servicos" class="hover:text-foreground transition-colors">Serviços</a></li>
            <li><a href="/#sobre" class="hover:text-foreground transition-colors">Sobre Nós</a></li>
            <li><a href="/noticias" class="hover:text-foreground transition-colors">Notícias</a></li>
            <li><a href="/trabalheconosco" class="hover:text-foreground transition-colors">Trabalhe Conosco</a></li>
            <li><a href="/#cliente" class="hover:text-foreground transition-colors">Área do Cliente</a></li>
            <li><a href="/privacidade" class="hover:text-foreground transition-colors">Política de Privacidade</a></li>
            <li><a href="/privacidade#cookies" data-cookies-abrir class="hover:text-foreground transition-colors">Preferências de cookies</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold mb-3">Contato</h4>
          <ul class="space-y-3 text-sm text-muted-foreground">
            <li class="flex items-center gap-2">
              <Icon name="Phone" size={14} class="text-primary" />
              <a href={contato.telefoneLink} target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition-colors">{contato.telefone}</a>
            </li>
            <li class="flex items-center gap-2">
              <Icon name="Mail" size={14} class="text-primary" />
              <a href={`mailto:${contato.email}`} class="hover:text-foreground transition-colors">{contato.email}</a>
            </li>
          </ul>
          <div class="mt-4 pt-4 border-t border-border text-xs text-muted-foreground space-y-1">
            <p class="flex items-center gap-2">
              <Icon name="Building2" size={13} class="text-primary shrink-0" />
              <span class="font-medium">{contato.razaoSocial}</span>
            </p>
            <p class="pl-[21px]">CNPJ: {contato.cnpj}</p>
          </div>
        </div>
        <div>
          <h4 class="font-semibold mb-3">Endereços</h4>
          <div class="grid grid-cols-2 gap-x-4 gap-y-2">
            {contato.enderecos.map((e) => (
              <div class="flex items-start gap-2 text-xs text-muted-foreground">
                <Icon name="MapPin" size={13} class="text-primary mt-0.5 shrink-0" />
                <span>{e}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="mt-12 pt-6 border-t border-border text-center text-xs text-muted-foreground space-y-1">
        <p>{rodape.copyright}</p>
        <p>Site desenvolvido por <span class="text-primary font-medium">{rodape.credito}</span></p>
      </div>
    </div>
  </div>
</footer>
