---
import { hero, whatsapp } from "../data/site";
---

<section class="relative min-h-screen flex items-center pt-20 overflow-hidden" data-hero>
  <div class="absolute inset-0 bg-gradient-to-br from-background via-background to-secondary"></div>
  <!-- brilho laranja que segue o mouse (igual ao original) -->
  <div class="absolute inset-0 pointer-events-none transition-opacity duration-300 opacity-0 z-[1]" data-hero-glow></div>
  <div class="container mx-auto px-4 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="animate-fade-in-up relative">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight mb-6 relative">
          {hero.tituloAntes} <span class="text-primary">{hero.tituloDestaque}</span>
        </h1>
        <p class="text-lg text-muted-foreground mb-8 max-w-lg relative">{hero.subtitulo}</p>
        <div class="flex flex-wrap gap-4 relative">
          <a
            href={whatsapp.abraEmpresa}
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3.5 rounded-lg btn-gradient-orange text-primary-foreground font-semibold text-base glow-orange"
          >{hero.botaoPrincipal}</a>
          <a
            href={whatsapp.trocarContador}
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3.5 rounded-lg border-2 border-primary text-primary font-semibold text-base hover:bg-primary hover:text-primary-foreground transition-colors"
          >{hero.botaoSecundario}</a>
        </div>
      </div>
      <div class="hidden lg:block animate-fade-in-up" style="animation-delay: 0.2s;">
        <img src={hero.foto} alt={hero.fotoAlt} loading="eager" fetchpriority="high" decoding="async" class="rounded-2xl shadow-2xl w-full object-cover max-h-[550px]" />
      </div>
    </div>
  </div>
</section>
