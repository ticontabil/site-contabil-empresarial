---
import Icon from "./Icon.astro";
import SectionTitle from "./SectionTitle.astro";
import { filiais, linkWaze } from "../data/secoes";
---

<section id="filiais" class="py-24">
  <div class="container mx-auto px-4">
    <SectionTitle titulo={filiais.titulo} destaque={filiais.destaque} subtitulo={filiais.subtitulo} wrapClass="text-center mb-12" />
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
      {filiais.cidades.map((f) => (
        <a
          href={linkWaze(f)}
          target="_blank"
          rel="noopener"
          class="group bg-card border border-border rounded-xl p-5 text-center card-hover flex flex-col items-center"
          aria-label={`${f.tipo} ${f.cidade} (${f.uf}): abrir rota no Waze`}
          data-rota={f.cidade}
        >
          <Icon name="MapPin" size={28} class="text-primary mx-auto mb-3" />
          <span class="text-[11px] font-semibold uppercase tracking-widest text-primary">{f.tipo}</span>
          <h3 class="font-semibold text-sm mt-1">{f.cidade}</h3>
          <p class="text-xs text-muted-foreground">{f.uf}</p>
          {f.endereco && <p class="text-xs text-muted-foreground mt-2 leading-snug">{f.endereco}</p>}
          <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-primary opacity-80 group-hover:opacity-100">Abrir no Waze <span aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>
  </div>
</section>
