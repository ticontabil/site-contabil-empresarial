---
// Uma notícia: título, resumo publicado pela fonte e botão para a matéria original.
// noindex: o conteúdo é da fonte; quem deve aparecer no Google com o texto é ela.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFlutuante from "../components/WhatsAppFlutuante.astro";
import { whatsapp } from "../data/site";
---
<Base title="Notícia | Contábil Empresarial" description="Resumo da notícia e link para a matéria original." noindex>
  <Header />
  <main class="pt-28 pb-20" data-noticia>
    <article class="container mx-auto max-w-3xl px-4">
      <a href="/noticias" class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground hover:text-foreground" data-voltar>← Todas as notícias</a>
      <div data-carregando class="mt-8 space-y-4" aria-hidden="true">
        <div class="h-6 w-40 rounded bg-secondary animate-pulse"></div>
        <div class="h-12 w-full rounded bg-secondary animate-pulse"></div>
        <div class="h-24 w-full rounded bg-secondary animate-pulse"></div>
      </div>
      <div data-conteudo class="hidden">
        <div class="mt-8 flex flex-wrap items-center gap-2 text-sm">
          <span class="rounded-full bg-primary/10 px-3 py-1 font-semibold text-primary" data-tema></span>
          <span class="text-muted-foreground" data-data></span>
        </div>
        <h1 class="mt-4 text-3xl md:text-4xl font-extrabold leading-tight" data-titulo></h1>
        <div class="mt-8 overflow-hidden rounded-2xl border border-border capa-grande" data-capa></div>
        <p class="mt-6 text-lg leading-relaxed text-muted-foreground [overflow-wrap:anywhere]" data-resumo></p>
        <div class="mt-8 rounded-xl border border-border bg-secondary/40 p-6">
          <p class="text-sm text-muted-foreground">Matéria publicada por <strong class="text-foreground" data-fonte></strong><span data-oficial class="hidden"> (fonte oficial)</span>.</p>
          <a data-link target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-2 rounded-lg btn-gradient-orange px-6 py-3.5 font-semibold text-primary-foreground glow-orange">
            Ler a matéria completa <span aria-hidden="true">↗</span>
          </a>
          <p class="mt-3 break-all text-xs text-muted-foreground" data-endereco></p>
        </div>
        <section class="mt-10 rounded-2xl border border-border p-6 md:flex md:items-center md:justify-between md:gap-6">
          <div>
            <h2 class="text-xl font-bold">Isso muda algo para a sua empresa?</h2>
            <p class="mt-1 text-muted-foreground">Fale com um especialista da Contábil Empresarial.</p>
          </div>
          <a href={whatsapp.especialista} target="_blank" rel="noopener" class="mt-4 md:mt-0 inline-flex shrink-0 rounded-lg border border-primary px-5 py-3 font-semibold text-primary hover:bg-primary hover:text-primary-foreground transition-colors">Falar no WhatsApp</a>
        </section>
        <section class="mt-12" data-relacionadas-bloco hidden>
          <h2 class="text-xl font-bold">Mais sobre o mesmo tema</h2>
          <ul class="mt-4 divide-y divide-border" data-relacionadas></ul>
        </section>
      </div>
      <p class="mt-10 hidden text-muted-foreground" data-erro>Não encontramos essa notícia. Ela pode ter saído da lista. <a href="/noticias" class="text-primary underline">Ver as notícias mais recentes</a>.</p>
    </article>
  </main>
  <Footer />
  <WhatsAppFlutuante />
</Base>

<script>
  import { capaNoticia } from "../scripts/capa-noticia";
  type Noticia = { id: string; titulo: string; resumo: string; link: string; data: string; fonte: string; oficial: boolean; tema: string; imagem?: string; credito?: string };
  const raiz = document.querySelector<HTMLElement>("[data-noticia]")!;
  const $ = <T extends HTMLElement>(s: string) => raiz.querySelector<T>(s)!;
  const id = new URLSearchParams(location.search).get("id") || "";
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

  function mostrar(itens: Noticia[]) {
    const n = itens.find((x) => x.id === id);
    $("[data-carregando]").remove();
    if (!n) { $("[data-erro]").classList.remove("hidden"); return; }
    document.title = `${n.titulo} | Notícias · Contábil Empresarial`;
    $("[data-tema]").textContent = n.tema;
    $("[data-data]").textContent = new Date(n.data).toLocaleDateString("pt-BR", { day: "2-digit", month: "long", year: "numeric" });
    $("[data-titulo]").textContent = n.titulo;
    $("[data-capa]").innerHTML = capaNoticia(n, true);
    $("[data-resumo]").textContent = n.resumo || "A fonte não publicou um resumo desta matéria. Clique abaixo para ler na íntegra.";
    $("[data-fonte]").textContent = n.fonte;
    $("[data-oficial]").classList.toggle("hidden", !n.oficial);
    const a = $<HTMLAnchorElement>("[data-link]");
    a.href = n.link;
    a.innerHTML = `Ler a matéria completa em ${esc(n.fonte)} <span aria-hidden="true">↗</span>`;
    $("[data-endereco]").textContent = n.link;
    const rel = itens.filter((x) => x.tema === n.tema && x.id !== n.id).slice(0, 5);
    if (rel.length) {
      $("[data-relacionadas]").innerHTML = rel.map((r) => `<li class="py-3"><a href="/noticia?id=${esc(r.id)}" class="font-medium hover:text-primary">${esc(r.titulo)}</a><span class="block text-xs text-muted-foreground mt-1">${esc(r.fonte)}</span></li>`).join("");
      $("[data-relacionadas-bloco]").hidden = false;
    }
    $("[data-conteudo]").classList.remove("hidden");
  }
  let cache: { itens: Noticia[] } | null = null;
  try { cache = JSON.parse(sessionStorage.getItem("noticias") || "null"); } catch {}
  if (cache?.itens?.some((x) => x.id === id)) mostrar(cache.itens);
  else fetch("/api/noticias.php").then((r) => r.json()).then((d) => mostrar(d.itens || [])).catch(() => mostrar([]));
  // "voltar" mantém os filtros da lista
  try {
    const r = new URL(document.referrer);
    if (r.origin === location.origin && r.pathname === "/noticias") $<HTMLAnchorElement>("[data-voltar]").href = r.pathname + r.search;
  } catch {}
</script>
