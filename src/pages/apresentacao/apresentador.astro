---
// /apresentacao/apresentador — modo apresentador: tela atual, próxima, Fala e cronômetro.
// As falas só existem nesta página; a página do cliente não as contém.
import Apresentacao from "../../layouts/Apresentacao.astro";
import { publicar } from "../../data/apresentacao.ts";
import { telasAtivas } from "../../lib/apresentacao-telas.ts";

const lista = telasAtivas().map(({ chave, numero, titulo, passos, fala, ato }) => ({ chave, numero, titulo, passos, fala, ato }));
// PUBLIC_APRESENTACAO_PREVIA=1 gera a apresentação no build só para teste local (nunca publicar esse build).
const emPreparacao = import.meta.env.PROD && !publicar && import.meta.env.PUBLIC_APRESENTACAO_PREVIA !== "1";
---
<Apresentacao titulo="Modo apresentador · Contábil Empresarial">
  {emPreparacao ? (
    <main style="height:100%;display:flex;align-items:center;justify-content:center;color:#c7c7c7">(Apresentação em preparação)</main>
  ) : (
    <>
      <style is:global>
        html, body { overflow: auto; background: #0b0b0b; }
        .ap { display: grid; grid-template-columns: 1.55fr 1fr; grid-template-rows: auto 1fr; gap: 18px; padding: 18px; height: 100vh; }
        .ap .quadro { position: relative; aspect-ratio: 16 / 9; background: #000; border-radius: 10px; overflow: hidden; border: 1px solid #222; }
        .ap .quadro iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; pointer-events: none; }
        .ap .etq { font-size: 12px; font-weight: 700; letter-spacing: .2em; color: #8a8a8a; margin-bottom: 8px; display: flex; justify-content: space-between; }
        .ap .etq b { color: #fb5d02; }
        .ap .lado { display: flex; flex-direction: column; gap: 18px; min-height: 0; }
        .ap .relogios { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .ap .relogio { background: #141414; border-radius: 10px; padding: 14px 16px; }
        .ap .relogio .v { font-size: 44px; font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: -.02em; }
        .ap .relogio .l { font-size: 12px; letter-spacing: .2em; color: #8a8a8a; font-weight: 700; }
        .ap .botoes { display: flex; gap: 8px; flex-wrap: wrap; }
        .ap .botoes button { background: #1f1f1f; border-radius: 999px; padding: 10px 18px; font-size: 14px; font-weight: 700; }
        .ap .botoes button.principal { background: #fb5d02; }
        .ap .fala { grid-column: 1 / -1; background: #141414; border-radius: 10px; padding: 22px 26px; overflow: auto; min-height: 0; }
        .ap .fala p { font-size: 26px; line-height: 1.5; font-weight: 400; max-width: 1400px; }
        .ap .fala .ph { color: #fb5d02; }
        .ap .aviso { font-size: 13px; color: #8a8a8a; }
      </style>
      <div class="ap">
        <div>
          <div class="etq"><span>TELA ATUAL</span><b id="ap-posicao"></b></div>
          <div class="quadro"><iframe id="ap-atual" title="Tela atual" tabindex="-1"></iframe></div>
        </div>
        <div class="lado">
          <div>
            <div class="etq"><span>PRÓXIMO</span><span id="ap-prox-rotulo"></span></div>
            <div class="quadro"><iframe id="ap-proxima" title="Próximo passo" tabindex="-1"></iframe></div>
          </div>
          <div class="relogios">
            <div class="relogio"><div class="l">CRONÔMETRO</div><div class="v" id="ap-crono">00:00</div></div>
            <div class="relogio"><div class="l">HORA</div><div class="v" id="ap-hora">--:--</div></div>
          </div>
          <div class="botoes">
            <button type="button" id="ap-voltar">← Voltar</button>
            <button type="button" id="ap-avancar" class="principal">Avançar →</button>
            <button type="button" id="ap-pausar">Iniciar cronômetro</button>
            <button type="button" id="ap-zerar">Zerar</button>
          </div>
          <p class="aviso" id="ap-conexao">Abra a apresentação em outra janela (ou aperte N nela). As duas ficam sincronizadas.</p>
        </div>
        <div class="fala"><div class="etq"><span>FALA</span><span id="ap-titulo"></span></div><p id="ap-fala"></p></div>
      </div>
      <script type="application/json" id="ap-dados" set:html={JSON.stringify(lista)}></script>
      <script>
        import "../../scripts/apresentacao/apresentador.ts";
      </script>
    </>
  )}
</Apresentacao>
