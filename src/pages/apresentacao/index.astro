---
// /apresentacao — apresentação comercial (página oculta: noindex, fora do menu e do sitemap).
import PreloaderLogo from "../../components/apresentacao/PreloaderLogo.astro";
import Apresentacao from "../../layouts/Apresentacao.astro";
import Icone from "../../components/apresentacao/Icone.astro";
import Capa from "../../components/apresentacao/telas/Capa.astro";
import Reforma from "../../components/apresentacao/telas/Reforma.astro";
import Datas from "../../components/apresentacao/telas/Datas.astro";
import Impacto from "../../components/apresentacao/telas/Impacto.astro";
import Virada from "../../components/apresentacao/telas/Virada.astro";
import Historia from "../../components/apresentacao/telas/Historia.astro";
import Numeros from "../../components/apresentacao/telas/Numeros.astro";
import Time from "../../components/apresentacao/telas/Time.astro";
import Departamentos from "../../components/apresentacao/telas/Departamentos.astro";
import Preparacao from "../../components/apresentacao/telas/Preparacao.astro";
import Parceiros from "../../components/apresentacao/telas/Parceiros.astro";
import Resultados from "../../components/apresentacao/telas/Resultados.astro";
import ComoComecar from "../../components/apresentacao/telas/ComoComecar.astro";
import ProximoPasso from "../../components/apresentacao/telas/ProximoPasso.astro";
import Investimento from "../../components/apresentacao/telas/Investimento.astro";
import QuemSomos from "../../components/apresentacao/telas/QuemSomos.astro";
import Missao from "../../components/apresentacao/telas/Missao.astro";
import Observacoes from "../../components/apresentacao/telas/Observacoes.astro";
import Obrigado from "../../components/apresentacao/telas/Obrigado.astro";
import { publicar } from "../../data/apresentacao.ts";
import { telasAtivas } from "../../lib/apresentacao-telas.ts";

const componentes = {
  capa: Capa, reforma: Reforma, datas: Datas, impacto: Impacto, virada: Virada,
  historia: Historia, numeros: Numeros, time: Time,
  departamentos: Departamentos, preparacao: Preparacao, parceiros: Parceiros,
  resultados: Resultados, comoComecar: ComoComecar, investimento: Investimento, proximoPasso: ProximoPasso,
  quemSomos: QuemSomos, missao: Missao, observacoes: Observacoes, obrigado: Obrigado,
} as const;

const lista = telasAtivas();
// No site publicado, a apresentação só aparece com `publicar = true` (e sem pendências; ver astro.config.mjs).
// PUBLIC_APRESENTACAO_PREVIA=1 gera a apresentação no build só para teste local (nunca publicar esse build).
const emPreparacao = import.meta.env.PROD && !publicar && import.meta.env.PUBLIC_APRESENTACAO_PREVIA !== "1";
---
<Apresentacao>
  {emPreparacao ? (
    <main style="height:100%;display:flex;align-items:center;justify-content:center;font-size:20px;color:#c7c7c7;letter-spacing:.2em;text-transform:uppercase">
      (Apresentação em preparação)
    </main>
  ) : (
    <>
      <div id="palco" data-total={lista.length}>
        {lista.map((info) => {
          const C = componentes[info.chave];
          return <C info={info} />;
        })}
        <div id="marca">
          <button type="button" id="marca-botao" aria-label="Menu da apresentação" aria-expanded="false" aria-controls="marca-menu">
            <img class="marca-escura" src="/logo-negative.png" alt="" width="568" height="229" />
            <img class="marca-clara" src="/logo.png" alt="" width="568" height="229" />
            <span class="marca-brilho" aria-hidden="true"></span>
          </button>
          <div id="marca-menu">
            <button type="button" class="marca-opcao" data-ir-inicio aria-label="Voltar ao início da apresentação"><Icone nome="inicio" tamanho={30} /></button>
            <a class="marca-opcao" href="/apresentacao/configurar" aria-label="Configurar valores"><Icone nome="ajustes" tamanho={30} /></a>
          </div>
        </div>
        <div id="progresso" aria-hidden="true">
          <span id="contador"></span>
          <div class="trilho"><div class="preenchido"></div></div>
        </div>
        <div id="tela-preta"></div>
        <div id="ir-para" aria-hidden="true"></div>
      </div>
      <!-- pré-loader: a logo se desenha enquanto as primeiras telas carregam; depois tudo se fecha numa linha de luz -->
      <div id="preloader" aria-hidden="true">
        <div class="pl-brilho"></div>
        <div class="pl-centro">
          <PreloaderLogo />
          <div class="pl-barra"><span id="pl-progresso"></span></div>
          <p class="pl-rotulo"><span>DESDE 1984</span><span id="pl-porcento">00</span></p>
        </div>
      </div>
      <p id="anuncio" class="sr-only" aria-live="polite"></p>
      <div id="gire" role="dialog" aria-label="Gire o celular">
        <span class="icone-gire"><Icone nome="gire" tamanho={72} /></span>
        <p>Gire o celular para ver a apresentação</p>
        <button type="button" id="ver-em-pe">Ver versão em pé</button>
      </div>
      <button type="button" id="botao-imprimir" hidden style="position:fixed;right:20px;top:20px;z-index:300;background:#fb5d02;color:#fff;border-radius:999px;padding:12px 22px;font-weight:700">Imprimir / salvar PDF</button>
      <script>
        import "../../scripts/apresentacao/deck.ts";
      </script>
    </>
  )}
</Apresentacao>
