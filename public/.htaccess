# Usado apenas se o site for publicado na Hostgator (Apache).
# Serve /trabalheconosco a partir de trabalheconosco.html e usa a página 404 do site.
Options -MultiViews
RewriteEngine On

# ---- Apresentação com senha ----
# Tudo o que começa com /apresentacao (página, configuração, modo apresentador, vídeos, service worker)
# passa pelo portão. Sem a senha, nada disso é entregue. Se o PHP falhar, o acesso fica fechado.
RewriteRule ^apresentacao-portao\.php$ - [L]
RewriteRule ^\.portao-chave\.php$ - [F,L]
RewriteRule ^apresentacao-portao-config\.php$ - [F,L]
RewriteRule ^(apresentacao.*)$ apresentacao-portao.php?arquivo=$1 [L,QSA,B]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.html
